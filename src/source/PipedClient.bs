namespace Piped
    
    ' Fetch data from a Piped instance while masking with browser headers to bypass bot detection
    function fetch(endpoint as String) as Object
        ' You can swap this out for your own self-hosted Piped instance URL if preferred
        url = "https://pipedapi.kavin.rocks" + endpoint
        
        port = CreateObject("roMessagePort")
        request = CreateObject("roUrlTransfer")
        request.SetURL(url)
        request.SetMessagePort(port)
        
        ' Configure certificates and anti-bot masking headers
        request.SetCertificates("common:/certs/ca-bundle.crt")
        request.InitClientCertificates()
        request.AddHeader("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36")
        request.AddHeader("Accept", "application/json")
        request.AddHeader("Referer", "https://piped.video/")
        
        if request.AsyncGetToString()
            msg = wait(5000, port)
            if type(msg) = "roUrlEvent"
                if msg.GetResponseCode() = 200
                    data = ParseJson(msg.GetString())
                    if data <> invalid
                        return { success: true, data: data }
                    end if
                else
                    print "Piped API HTTP Error: " + Stri(msg.GetResponseCode())
                end if
            else
                print "Piped API Request Timed Out"
                request.AsyncCancel()
            end if
        end if
        
        return { success: false, data: invalid }
    end function

    ' Convenience function to fetch trending videos
    function getTrending() as Object
        return Piped.fetch("/trending?region=US")
    end function

    ' Convenience function to search videos
    function search(query as String) as Object
        encodedQuery = Substitute("/search?q={0}&filter=videos", query)
        return Piped.fetch(encodedQuery)
    end function

end namespace
